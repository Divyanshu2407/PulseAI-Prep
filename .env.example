# Firebase Admin SDK (server-only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project.iam.gserviceaccount.com

# Gemini question generation and feedback (server-only)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# Gemini Live short-lived session tokens (server-only)
GEMINI_API_KEY=your-gemini-api-key

# Optional: use a separate key for feedback discussion
# If omitted, GOOGLE_GENERATIVE_AI_API_KEY is used.
GEMINI_DISCUSSION_API_KEY=

# Optional comma-separated emails allowed to manually grant/revoke Premium.
# Premium is admin-assigned until a payment provider is configured.
PREMIUM_ADMIN_EMAILS=

# Optional server-only coupon code that grants Premium to each account once.
# Use a custom value of at least 7 characters. Keep it private; never use NEXT_PUBLIC_.
PREMIUM_COUPON_CODE=
